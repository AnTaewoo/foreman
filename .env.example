# 복사해서 .env 로 쓴다. 값이 비어 있으면 control_plane/config.py 의 기본값이 쓰인다(빈 값 = 미설정).
# 모든 키는 HITL_ 프리픽스. .env 는 git 에 올라가지 않는다.

# --- 안전장치 ---
# 실제 GitHub API 호출 여부. 기본 true (dry-run). 실 GitHub 연결(README §4, App 점검 [ok] 이후)에서만 false.
HITL_DRY_RUN=

# --- 인프라 ---
# 예: postgresql+asyncpg://hitl:hitl@localhost:5432/hitl
HITL_DATABASE_URL=
# 예: redis://localhost:6379/0
HITL_REDIS_URL=

# --- LLM provider 선택 (D-33) ---
# anthropic | openai_compat. 로컬 Ollama면 openai_compat
HITL_LLM_PROVIDER=
# openai_compat 엔드포인트 (Ollama 기본 http://localhost:11434/v1)
HITL_LLM_BASE_URL=
# openai_compat 모델 (예: qwen2.5-coder:7b)
HITL_LLM_MODEL=
# openai_compat 키 (Ollama는 아무 값이나; 기본 ollama)
HITL_LLM_API_KEY=

# --- LLM (Anthropic) ---
# HITL_LLM_PROVIDER=anthropic 일 때 필수.
HITL_ANTHROPIC_API_KEY=
# 기본 claude-opus-5
HITL_ANTHROPIC_MODEL=
# 비용 단가 (D-39): USD per 1M tokens, 입력/출력. 비우면 0 → run.finished.cost_usd = 0
HITL_LLM_PRICE_IN_PER_MTOK=
HITL_LLM_PRICE_OUT_PER_MTOK=

# --- GitHub App (Dry 모드에서는 비워 둔다. 실 연결은 README §4) ---
HITL_GITHUB_APP_ID=
# PEM 전체. 개행은 \n 으로 이스케이프
HITL_GITHUB_APP_PRIVATE_KEY=
HITL_GITHUB_INSTALLATION_ID=
# 웹훅 HMAC 서명 검증용
HITL_GITHUB_WEBHOOK_SECRET=

# --- 상주 control plane (P6.1, `make run-control-plane`) ---
# docker | inprocess (Docker 없는 개발 환경: control plane 프로세스 안에서 Coding Agent 실행)
HITL_WORKER_LAUNCHER=
# docker 런처가 띄울 워커 이미지 (기본 foreman-worker:dev)
HITL_WORKER_IMAGE=
# 동시 워커 수 (기본 4)
HITL_SCHEDULER_MAX_WORKERS=
# repo 확보 루트 (D-38): owner/name 프로젝트를 여기에 clone. 로컬 경로 프로젝트는 그대로 씀. 기본 ./repos
HITL_REPO_ROOT=

# --- 로깅 ---
# DEBUG | INFO | WARNING | ERROR
HITL_LOG_LEVEL=
# json | console
HITL_LOG_FORMAT=
