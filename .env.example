# 복사해서 .env 로 쓴다. 값은 전부 비어 있고, 비우면 control_plane/config.py 의 기본값이 쓰인다.
# 모든 키는 HITL_ 프리픽스. .env 는 git 에 올라가지 않는다.

# --- 안전장치 ---
# 실제 GitHub API 호출 여부. 기본 true (dry-run). MVP 1 전 구간에서 false 로 바꾸지 않는다.
HITL_DRY_RUN=

# --- 인프라 ---
# 예: postgresql+asyncpg://hitl:hitl@localhost:5432/hitl
HITL_DATABASE_URL=
# 예: redis://localhost:6379/0
HITL_REDIS_URL=

# --- LLM provider 선택 (D-33) ---
# anthropic | openai_compat | fake. 개발·PC-3 1차 검증은 openai_compat(로컬 Ollama), PC-5 최종 판정은 anthropic
HITL_LLM_PROVIDER=
# openai_compat 엔드포인트 (Ollama 기본 http://localhost:11434/v1)
HITL_LLM_BASE_URL=
# openai_compat 모델 (예: qwen2.5-coder:7b)
HITL_LLM_MODEL=
# openai_compat 키 (Ollama는 아무 값이나; 기본 ollama)
HITL_LLM_API_KEY=

# --- LLM (Anthropic) ---
# 실 LLM 검사(PC-3, PC-5)에만 필요. 비우면 FakeProvider 만 쓸 수 있다.
HITL_ANTHROPIC_API_KEY=
# 기본 claude-opus-5
HITL_ANTHROPIC_MODEL=

# --- GitHub App (X.1 실 연결 전까지 비워 둔다) ---
HITL_GITHUB_APP_ID=
# PEM 전체. 개행은 \n 으로 이스케이프
HITL_GITHUB_APP_PRIVATE_KEY=
HITL_GITHUB_INSTALLATION_ID=
# 웹훅 HMAC 서명 검증용
HITL_GITHUB_WEBHOOK_SECRET=

# --- MinIO (Run 로그/아티팩트) ---
# 예: http://localhost:9000 (호스트 포트를 바꿨으면 여기도 맞춘다)
HITL_MINIO_ENDPOINT=
HITL_MINIO_ACCESS_KEY=
HITL_MINIO_SECRET_KEY=
HITL_MINIO_BUCKET=

# --- 상주 control plane (P6.1, `make run-control-plane`) ---
# docker | inprocess (Docker 없는 개발 환경: control plane 프로세스 안에서 Coding Agent 실행)
HITL_WORKER_LAUNCHER=
# docker 런처가 띄울 워커 이미지 (기본 foreman-worker:dev)
HITL_WORKER_IMAGE=
# 동시 워커 수 (기본 4)
HITL_SCHEDULER_MAX_WORKERS=

# --- 로깅 ---
# DEBUG | INFO | WARNING | ERROR
HITL_LOG_LEVEL=
# json | console
HITL_LOG_FORMAT=
