# 복사해서 .env 로 쓴다. 값이 비어 있으면 control_plane/config.py 의 기본값이 쓰인다(빈 값 = 미설정).
# 모든 키는 HITL_ 프리픽스. .env 는 git 에 올라가지 않는다.

# --- 안전장치 ---
# 실제 GitHub API 호출 여부. 기본 true (dry-run). 실 GitHub 연결(README §4, App 점검 [ok] 이후)에서만 false.
HITL_DRY_RUN=

# --- 인프라 ---
# 예: postgresql+asyncpg://hitl:hitl@localhost:5432/hitl
HITL_DATABASE_URL=
# 예: redis://localhost:6379/0
HITL_REDIS_URL=

# --- LLM provider 선택 (D-33) ---
# anthropic | openai_compat. 로컬 Ollama면 openai_compat
HITL_LLM_PROVIDER=
# openai_compat 엔드포인트 (Ollama 기본 http://localhost:11434/v1)
HITL_LLM_BASE_URL=
# openai_compat 모델. 로컬 12GB GPU 기준 qwen2.5-coder:14b 권장 (docs/pc/X-2.md P9.5 비교)
HITL_LLM_MODEL=
# openai_compat 키 (Ollama는 아무 값이나; 기본 ollama)
HITL_LLM_API_KEY=

# --- LLM (OpenAI, D-57 프로파일 "openai") ---
# 콘솔에서 Goal마다 ollama / openai / anthropic 을 고른다. 키가 있는 프로파일만 선택 가능
HITL_OPENAI_API_KEY=
# 예: gpt-5.6 (모델 id 그대로)
HITL_OPENAI_MODEL=
# 기본 https://api.openai.com/v1
HITL_OPENAI_BASE_URL=
# completion 예산(추론 토큰 포함). 기본 16384. gpt-5.x는 max_completion_tokens로 보낸다
HITL_OPENAI_MAX_TOKENS=
# 기본 프로파일 고정 (ollama|openai|anthropic). 비우면 자동 — openai 키가 있으면 openai (P9.15)
HITL_LLM_DEFAULT_PROFILE=

# --- LLM (Anthropic, 프로파일 "anthropic") ---
# HITL_LLM_PROVIDER=anthropic 일 때 필수.
HITL_ANTHROPIC_API_KEY=
# 기본 claude-opus-5
HITL_ANTHROPIC_MODEL=
# 비용 단가 (D-39): USD per 1M tokens, 입력/출력. 비우면 0 → run.finished.cost_usd = 0
HITL_LLM_PRICE_IN_PER_MTOK=
HITL_LLM_PRICE_OUT_PER_MTOK=

# --- GitHub App (Dry 모드에서는 비워 둔다. 실 연결은 README §4) ---
HITL_GITHUB_APP_ID=
# PEM 전체. 개행은 \n 으로 이스케이프
HITL_GITHUB_APP_PRIVATE_KEY=
HITL_GITHUB_INSTALLATION_ID=
# 웹훅 HMAC 서명 검증용
HITL_GITHUB_WEBHOOK_SECRET=

# --- 상주 control plane (P6.1, `make run-control-plane`) ---
# docker | inprocess (Docker 없는 개발 환경: control plane 프로세스 안에서 Coding Agent 실행)
HITL_WORKER_LAUNCHER=
# docker 런처가 띄울 워커 이미지 (기본 foreman-worker:dev)
HITL_WORKER_IMAGE=
# 동시 워커 수 (기본 4)
HITL_SCHEDULER_MAX_WORKERS=
# repo 확보 루트 (D-38): owner/name 프로젝트를 여기에 clone. 로컬 경로 프로젝트는 그대로 씀. 기본 ./repos
HITL_REPO_ROOT=

# --- 공개 데모 (P9.3, D-52) — 인터넷에 노출할 때만 ---
# true면 POST /projects·cancel·task patch는 X-Admin-Token, Goal 생성은 프로젝트·시간·IP 한도
HITL_DEMO_MODE=
# openssl rand -hex 24. 비어 있으면 데모 모드의 관리 라우트는 항상 401
HITL_ADMIN_TOKEN=
# 콘솔이 보내는 X-User-Id (데모 프로젝트 members의 approver). 기본 judge
HITL_DEMO_USER_ID=
# 프로젝트당 진행 중 Goal 수 / 시간당 생성 수 / IP당 쓰기 요청 분당 (기본 1 / 6 / 10)
HITL_DEMO_MAX_RUNNING_GOALS=
HITL_DEMO_GOALS_PER_HOUR=
HITL_DEMO_POST_PER_IP_PER_MIN=

# --- 로깅 ---
# DEBUG | INFO | WARNING | ERROR
HITL_LOG_LEVEL=
# json | console
HITL_LOG_FORMAT=
